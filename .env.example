# Google Sheets -> Perfox CRM connector. Copy to .env for local runs (never commit .env).
# On a server, set these as environment variables instead.

APP_ENV=production                 # production refuses to start without the required values below
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
CONNECTOR_MONGODB_DB=sheets_connector

# Protects every /v1 route (send it as the X-Api-Key header). 24+ random characters.
ADMIN_API_KEY=<long random value>

# CRM -> Account -> Sources: add a source of kind "Records from another system", make its key,
# and copy the "Address for records".
CRM_RECORDS_URL=<address for records>
CRM_SOURCE_KEY=<the source's key>
# More than one CRM account (optional): '{"acme": {"records_url": "https://...", "key_env": "CRM_KEY_ACME"}}'
# CRM_PROFILES=

# Tuning (defaults shown)
# DEFAULT_POLL_MINUTES=5
# MAX_ROWS_PER_SYNC=200
# MAX_ATTEMPTS_PER_ROW=5
# CRM_CONCURRENCY=4
# CRM_MAX_REQUESTS_PER_SECOND=5
# WORKER_CONCURRENCY=2
# SCHEDULER_ENABLED=true
# LOG_LEVEL=INFO
