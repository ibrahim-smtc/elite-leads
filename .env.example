MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=crm_staging
MONGODB_COLLECTION=elite_vw_leads
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/<your-sheet-id>/edit#gid=0

# --- CRM step (lead_to_crm.py) ---
PERFOX_API_KEY=<perfox workspace api key>
PERFOX_AGENT_WEBHOOK_URL=<full url of the customer-updates agent webhook trigger>
PERFOX_AGENT_WEBHOOK_SECRET=<the webhook trigger's shared secret>
# shared secret the Google Apps Script sends in the X-Sync-Secret header (required when deployed)
SYNC_SECRET=<long random value>
# optional
LEADS_DB=elite-test-db
LEADS_COLLECTION=og-leads
CRM_AGENT_BATCH=5
# CRM_MAX_PER_RUN=0   (0 or unset = no cap)

