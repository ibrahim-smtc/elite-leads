MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# optional: used only when a /sync request does not name a database / collection
MONGODB_DB=elite-test-db
MONGODB_COLLECTION=og-leads
# optional: only for running `python sync.py` by hand. POST /sync takes the sheet link from the request.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/<your-sheet-id>/edit#gid=0

# --- Timer: server downloads the sheet by itself (no Apps Script needed) ---
# Set the sheet link to turn it on. Unset = timer off (POST /sync still works).
# AUTO_SYNC_SHEET_URL=https://docs.google.com/spreadsheets/d/<your-sheet-id>/edit#gid=0
# AUTO_SYNC_MINUTES=10

# --- CRM step (lead_to_crm.py) ---
PERFOX_API_KEY=<perfox workspace api key>
PERFOX_AGENT_WEBHOOK_URL=<full url of the customer-updates agent webhook trigger>
PERFOX_AGENT_WEBHOOK_SECRET=<the webhook trigger's shared secret>
# shared secret the caller sends in the X-Sync-Secret header.
# Unset = /sync is open (fine for testing). Set it before production.
# SYNC_SECRET=<long random value>
# optional
LEADS_DB=elite-test-db
LEADS_COLLECTION=og-leads
CRM_AGENT_BATCH=5
# most leads the agent processes per run (default 10 while testing; 0 = no cap)
# CRM_MAX_PER_RUN=10
# seconds to wait after creating a customer before the agent looks for it (the CRM needs a moment to see it)
# CRM_SETTLE_SECONDS=30

